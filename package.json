{
  "name": "arena-bridge",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "连接 Arena Agent 与本机项目，支持文件读写、代码搜索和命令执行，并提供模型与推理档位识别、自动抽卡功能。",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/cli.mjs",
    "readonly": "node server/cli.mjs --readonly",
    "write": "node server/cli.mjs --write",
    "full": "node server/cli.mjs --write --exec"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.2"
  }
}
